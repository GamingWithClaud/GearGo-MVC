@model GearGo.Models.Equipment

<article class="product-card">
	<a class="product-photo" asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.Id" aria-label="View @Model.Name">
		<img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
		<span class="category-label">@Model.Category</span>
	</a>
	<div class="product-info">
		<div class="product-title-row">
			<h2>@Model.Name</h2>
			<span class="availability @(Model.IsAvailable ? "is-available" : "is-unavailable")">
				<partial name="_EquipmentAvailability" model="Model" />
			</span>
		</div>
		<p class="product-description">@Model.Description</p>
		<div class="product-bottom">
			<p class="product-price">R @Model.DailyRate.ToString("0.00") <span>/ day</span></p>
			<a class="product-link" asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.Id" aria-label="View details for @Model.Name">
				<span aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</div>
</article>
