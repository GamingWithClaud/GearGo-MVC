@{
    ViewData["Title"] = "Adventure starts here";
}

<section class="home-hero" aria-labelledby="hero-title">
    <img class="hero-image"
         src="https://images.unsplash.com/photo-1551632811-561732d1e306?auto=format&fit=crop&w=2200&q=85"
         alt="Hikers following a trail through a mountain landscape" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content">
        <p class="eyebrow hero-eyebrow"><span></span> Your next escape starts here</p>
        <h1 id="hero-title">GearGo</h1>
        <p class="hero-copy">Good gear for the places you haven't been yet.</p>
        <a class="button button-lime" asp-controller="Equipment" asp-action="Index">
            Find your gear <span aria-hidden="true">&rarr;</span>
        </a>
    </div>
    <p class="hero-caption">Take the long way.</p>
</section>

<section class="home-intro content-width" aria-labelledby="intro-title">
    <div class="intro-heading">
        <p class="eyebrow">The outdoors, on your terms</p>
        <h2 id="intro-title">Own less.<br />Get out more.</h2>
    </div>
    <div class="intro-side">
        <p>From first light at the trailhead to one more night under the stars, get the kit you need without filling your cupboards with it.</p>
        <a class="text-link" asp-controller="Equipment" asp-action="Index">See all equipment <span aria-hidden="true">&rarr;</span></a>
    </div>
</section>

<section class="benefits content-width" aria-label="Why rent with GearGo">
    <article class="benefit-item">
        <span class="benefit-number">01</span>
        <div><h3>Ready for the real world</h3><p>Practical, dependable kit for days outside.</p></div>
    </article>
    <article class="benefit-item">
        <span class="benefit-number">02</span>
        <div><h3>Room for your next plan</h3><p>Rent what you need for the trip ahead.</p></div>
    </article>
    <article class="benefit-item">
        <span class="benefit-number">03</span>
        <div><h3>More outside, less stuff</h3><p>Make space for experiences, not storage.</p></div>
    </article>
</section>
